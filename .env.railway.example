# ضع هذه المتغيرات في Railway > Variables (وليس في الكود)
APP_NAME=Portfolio
APP_ENV=production
APP_DEBUG=false
APP_KEY=           # نفّذ محلياً: php artisan key:generate --show   ثم انسخ الناتج هنا
APP_URL=https://اسم-موقعك.up.railway.app

DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
